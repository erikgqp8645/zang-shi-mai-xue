# macOS
.DS_Store

# 临时转换产物（docx/pdf 抽取中间件）
*.tmp
~$*
.~lock.*
__pycache__/

# Python 虚拟环境
.venv/
venv/

# Node / 前端子项目
node_modules/
dist/
*.local

# 病例记录库（运行产物，不进版本库）
local-data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# 小程序共享包编译产物（npm run build:core 生成，不进版本库）
pulse-record/miniprogram/utils/core/
pulse-record/miniprogram/assets/

# 鸿蒙工程（pulse-record/harmony/）
#   · 工程配置本身**入库** —— 它是这条链路的唯一真源
#   · 生成物（Taro 的 .ets 产物 / oh_modules / SDK 路径 / hvigor 缓存）不入库，
#     由 pulse-record/harmony/.gitignore 自己管
# 正式构建走 scripts/harmony-build.mjs（镜像到纯 ASCII 路径再编，
# 因为 hvigor 不接受含中文的工程路径）。
pulse-record/taro/harmony/

# Taro/SWC 的本机编译缓存（平台专属二进制，2.6 MB，进库对别的机器没用）
pulse-record/taro/.swc/
pulse-record/taro/.temp/
pulse-record/taro/.rpt2_cache/

# 运行时产物（Mavis canvas 缓存等）
.mavis/
.workbuddy/

# 桌面版打包产物（electron-builder 输出，不进版本库）
pulse-record/release/
# 打包时的临时输出目录（换个 output 目录避开旧产物被占用时用）
# app.asar 常年被宿主应用的索引锁住，删不掉 —— 别让它进版本库
pulse-record/release-new/

# 微信开发者工具的本地配置（含个人 AppID 等，不进版本库）
pulse-record/miniprogram/project.private.config.json

# CloudBase 云函数部署包（scripts/build-cloudfunction.mjs 组装，真源在 server/）
pulse-record/.cloudfn/

# 微信小程序凭据（AppSecret、代码上传私钥）—— 绝不进版本库
pulse-record/.secrets/
*.key
!pulse-record/miniprogram/**/*.key
