.pr-cases-head {
  margin-bottom: 24rpx;
}

.pr-cases-search {
  position: relative;
}

.pr-cases-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e6e2d6;
  color: #5c574f;
  font-size: 30rpx;
}

.pr-cases-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.pr-err {
  color: #b03a2e;
}

.pr-case-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pr-case-name {
  font-size: 32rpx;
  font-weight: 600;
}

.pr-case-rename {
  width: 320rpx;
}

.pr-case-meta {
  color: #7c8974;
  font-size: 24rpx;
}

.pr-case-badge {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #b48464;
}

.pr-case-ops {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 12rpx;
}

.pr-case-visits {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e6e2d6;
}

.pr-visit {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #e6e2d6;
}

.pr-visit-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pr-visit-label {
  font-weight: 600;
}

.pr-visit-at {
  color: #a39a8c;
  font-size: 22rpx;
}

.pr-visit-summary {
  color: #5c574f;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.pr-visit-tags {
  color: #b48464;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.pr-link {
  color: #7c8974;
  font-size: 24rpx;
  text-decoration: underline;
}

.pr-x {
  color: #b03a2e;
  font-size: 30rpx;
  padding: 0 8rpx;
}
