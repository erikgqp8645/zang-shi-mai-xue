/* 录入页 · 工具条与保存条
   （主表的版式与弹层样式在 components/record-sheet/record-sheet.wxss 里 ——
     病例详情页的「记录表」用同一个组件，两边共用同一份样式） */

.pr-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pr-name-input {
  flex: 1;
  min-width: 0;
}

.pr-toolbar-ops {
  display: flex;
  gap: 12rpx;
}

.pr-err {
  color: #b03a2e;
  margin-bottom: 16rpx;
}

/* ---------- 保存条 ---------- */

.pr-save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fdfbf7;
  border-top: 1rpx solid #e6e2d6;
}
