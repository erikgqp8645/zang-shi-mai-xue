.pr-canvas-scroll {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e6e2d6;
  border-radius: 8rpx;
  margin: 12rpx 0;
}

.pr-canvas {
  display: block;
}

.pr-case-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pr-case-name {
  font-size: 34rpx;
  font-weight: 600;
}

.pr-case-meta {
  color: #7c8974;
  font-size: 24rpx;
}

.pr-case-ops {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 16rpx;
}

.pr-link {
  color: #7c8974;
  font-size: 24rpx;
  text-decoration: underline;
}

.pr-visit {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #e6e2d6;
}

.pr-visit-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pr-visit-label {
  font-weight: 600;
}

.pr-visit-at {
  color: #a39a8c;
  font-size: 22rpx;
}

.pr-visit-summary {
  color: #5c574f;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.pr-visit-tags {
  color: #b48464;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.pr-err {
  color: #b03a2e;
}
