/* 依脉用方（小程序端）—— 版式基调与网站端一致：宣纸底 / 墨 / 黛 / 陶 */

.pr-err {
  color: #b03a2e;
}

/* ---------- 判读提示 ---------- */

.pr-rule-group {
  margin-top: 20rpx;
}

.pr-rule-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #7c8974;
  margin-bottom: 8rpx;
}

.pr-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  margin-right: 10rpx;
  vertical-align: 2rpx;
  color: #fdfbf7;
  background: #7c8974;
}

.pr-badge.is-high {
  background: #b03a2e;
}

.pr-badge.is-warn {
  background: #b48464;
}

.pr-badge.is-info {
  background: #7c8974;
}

/* 命中的格子 */
.pr-cells {
  margin-top: 8rpx;
}

.pr-cell {
  display: inline-block;
  padding: 2rpx 12rpx;
  margin: 0 10rpx 8rpx 0;
  border: 1rpx solid #e6e2d6;
  border-radius: 8rpx;
  background: #faf7f0;
  color: #5c574f;
  font-size: 22rpx;
}

/* ---------- 依脉用方 ---------- */

.pr-formula-group {
  margin-top: 24rpx;
}

.pr-formula-route {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2925;
  border-left: 6rpx solid #b48464;
  padding-left: 14rpx;
  margin-bottom: 8rpx;
}

.pr-formula {
  border: 1rpx solid #e6e2d6;
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  margin: 14rpx 0;
  background: #ffffff;
}

.pr-formula-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.pr-formula-kind {
  display: inline-block;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: #f0ead9;
  color: #8a6a4f;
  font-size: 21rpx;
}

.pr-formula-cond {
  font-size: 27rpx;
  font-weight: 600;
}

.pr-formula-therapy {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #5c574f;
}

.pr-formula-names {
  margin-top: 10rpx;
}

.pr-formula-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  margin: 0 10rpx 8rpx 0;
  border-radius: 999rpx;
  background: #f0ead9;
  color: #5c574f;
  font-size: 24rpx;
}

.pr-formula-adds {
  margin-top: 6rpx;
  color: #a39a8c;
  font-size: 22rpx;
}

.pr-formula-quote {
  margin-top: 10rpx;
  color: #5c574f;
  font-size: 24rpx;
  line-height: 1.7;
}

/* 归类标记（also／basis） */
.pr-attr {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.pr-attr-main {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #7c8974;
  color: #fdfbf7;
  font-size: 21rpx;
  margin-right: 10rpx;
}

.pr-attr-also {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #eae5d8;
  color: #8a6a4f;
  font-size: 21rpx;
  margin-right: 10rpx;
}

.pr-attr-site {
  color: #a39a8c;
  font-size: 21rpx;
}

.pr-attr-basis {
  margin-top: 6rpx;
  color: #a39a8c;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ---------- 组成与剂量（两套并列） ---------- */

.pr-dose {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #faf7f0;
  border-radius: 8rpx;
}

.pr-dose-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c2925;
}

.pr-dose-block {
  margin-top: 8rpx;
}

.pr-dose-tag {
  display: block;
  font-size: 21rpx;
  color: #8a6a4f;
  margin-bottom: 4rpx;
}

.pr-dose-entry {
  font-size: 23rpx;
  color: #5c574f;
  line-height: 1.7;
}

.pr-dose-none {
  font-size: 23rpx;
  color: #a39a8c;
}

.pr-dose-sci {
  color: #7c8974;
}

.pr-dose-usage {
  color: #7c8974;
}

.pr-dose-src {
  display: block;
  color: #a39a8c;
  font-size: 20rpx;
}

.pr-dose-ref {
  color: #a39a8c;
  font-size: 20rpx;
}

/* ---------- 方剂卡（讲稿 2010／同和堂版） ---------- */

.pr-drug-group {
  margin-top: 20rpx;
}

.pr-drug-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #7c8974;
  margin-bottom: 6rpx;
}

.pr-drug {
  border-top: 1rpx dashed #e6e2d6;
  padding: 14rpx 0;
}

.pr-drug-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.pr-drug-therapy {
  padding: 2rpx 12rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: #f0ead9;
  color: #8a6a4f;
  font-size: 21rpx;
}

.pr-drug-name {
  font-size: 27rpx;
  font-weight: 600;
}

.pr-drug-line {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5c574f;
  line-height: 1.7;
}

.pr-drug-line.is-warn {
  color: #8a6a4f;
}

.pr-drug-key {
  display: inline-block;
  min-width: 96rpx;
  color: #a39a8c;
  font-size: 21rpx;
}

.pr-drug-add {
  display: block;
  padding-left: 96rpx;
}

/* ---------- 分组筛选 ---------- */

.pr-filter-row {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e6e2d6;
}

.pr-filter-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.pr-filter-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c2925;
  margin-right: 24rpx;
}

.pr-filter-act {
  color: #7c8974;
  font-size: 22rpx;
  text-decoration: underline;
  margin-right: 20rpx;
}

.pr-chip-filter {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.3;
}

.pr-chip-name {
  font-size: 24rpx;
}

.pr-chip-num {
  font-size: 19rpx;
  opacity: 0.75;
}

/* ---------- 原文对照（讲义 p42／附表一） ---------- */

.pr-ref {
  border-top: 1rpx solid #e6e2d6;
  padding: 14rpx 0;
}

.pr-ref-head {
  display: flex;
  align-items: baseline;
}

.pr-ref-no {
  min-width: 44rpx;
  color: #a39a8c;
  font-size: 22rpx;
}

.pr-ref-name {
  font-size: 26rpx;
  font-weight: 600;
}

.pr-ref-row {
  display: flex;
  margin-top: 8rpx;
}

.pr-ref-k {
  width: 190rpx;
  flex-shrink: 0;
  color: #a39a8c;
  font-size: 21rpx;
  line-height: 1.7;
}

.pr-ref-v {
  flex: 1;
  font-size: 24rpx;
  color: #5c574f;
  line-height: 1.7;
}
