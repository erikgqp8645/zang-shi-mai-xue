{
  "$schema": "./schema/pulse-terms.schema.json",
  "terms": {
    "无": {
      "codes": [
        "0"
      ],
      "display": "0"
    },
    "弱": {
      "codes": [
        "-"
      ],
      "display": "-"
    },
    "无或弱": {
      "codes": [
        "0",
        "-"
      ],
      "display": "0",
      "note": "讲义 p33：小＝无、弱"
    },
    "虚脏": {
      "codes": [
        "0",
        "-"
      ],
      "display": "0",
      "note": "虚脏 ＝ 弱或无（讲稿 2010·第十四讲）"
    },
    "软": {
      "codes": [
        "+",
        "±"
      ],
      "display": "+",
      "note": "软 ＝ 力度居中（讲稿：「软脉是胃出血的脉」）"
    },
    "有": {
      "codes": [
        "+",
        "±",
        "++",
        "±±",
        "+++",
        "++++",
        "↑"
      ],
      "display": "+",
      "note": "有 ＝ 力度中以上（讲义 p33：中＝有；含大）"
    },
    "大": {
      "codes": [
        "++",
        "±±",
        "+++",
        "++++"
      ],
      "display": "++",
      "note": "大 ＝ 有力（讲义 p33：大＝大于正常称「大」「力」）。⚠️ 讲义 p34 的「主要脉象」栏把 ↑ 也算进「力（大）」，而代码里 isDa 不含 ↑ —— 讲义两处本身就不一致。这里取代码实际接受的那一套；用「大或顶」的条目才把 ↑ 算进去。"
    },
    "大或顶": {
      "codes": [
        "++",
        "±±",
        "+++",
        "++++",
        "↑"
      ],
      "display": "++",
      "note": "大或顶 ＝ 力度 ≥ 2（含顶手）—— 代码里 fuDa／strengthOf ≥ 2 的那一套"
    },
    "洪大": {
      "codes": [
        "+++",
        "++++",
        "↑"
      ],
      "display": "+++",
      "note": "洪大 ＝ 比「大」还大的一档（讲义 p33）"
    },
    "洪大或弦": {
      "codes": [
        "+++",
        "++++",
        "↑",
        "|"
      ],
      "display": "+++",
      "note": "洪大或弦 ＝ 讲稿写「浮洪或者弦」时的两路并集（讲稿 2010·第四讲·清挡路二）"
    },
    "顶手": {
      "codes": [
        "↑"
      ],
      "display": "↑",
      "note": "顶手 ＝ 讲稿点名的「顶」"
    },
    "有力": {
      "codes": [
        "++",
        "±±",
        "+++",
        "++++",
        "↑"
      ],
      "display": "++",
      "note": "有力（不限是否顶手）"
    },
    "弦": {
      "codes": [
        "|"
      ],
      "display": "|"
    },
    "细": {
      "codes": [
        "X"
      ],
      "display": "X"
    },
    "变脉": {
      "codes": [
        "#",
        "TTT",
        "DDX"
      ],
      "display": "#"
    },
    "变脉无力": {
      "codes": [
        "#",
        "TTT",
        "DDX"
      ],
      "also": [
        "0",
        "-"
      ],
      "display": "#0",
      "note": "变脉且无力（讲稿 2010·第四讲「变脉无力」）"
    },
    "变脉有力": {
      "codes": [
        "#",
        "TTT",
        "DDX"
      ],
      "also": [
        "++",
        "±±",
        "+++",
        "++++",
        "↑"
      ],
      "display": "#++",
      "note": "变脉且有力（讲稿 2010·第二讲「变脉有力」）"
    },
    "有值": {
      "codes": [
        "0",
        "-",
        "+",
        "±",
        "++",
        "±±",
        "+++",
        "++++",
        "↑",
        "|",
        "#",
        "TTT",
        "DDX",
        "X"
      ],
      "display": "有",
      "note": "有值即可（不限力度）"
    }
  }
}
